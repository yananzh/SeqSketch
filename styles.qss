/* 浅色主题 */
/* Compact controls for the tree preview; scoped to this toolbar. */
QWidget#treePreviewToolbar {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
}
QWidget#treePreviewToolbar QToolButton {
    background: #ffffff;
    color: #334155;
    border: 1px solid #d8e0ea;
    border-radius: 5px;
    padding: 0;
    font-size: 14px;
}
QWidget#treePreviewToolbar QToolButton:hover {
    background: #edf5ff;
    color: #2563a6;
    border-color: #93b7e2;
}
QWidget#treePreviewToolbar QToolButton:pressed {
    background: #dcecff;
    border-color: #4a90e2;
}
QWidget#treePreviewToolbar QToolButton:focus {
    border-color: #4a90e2;
}
QWidget#treePreviewToolbar QToolButton:disabled {
    color: #a8b2c0;
    background: #f1f5f9;
    border-color: #e2e8f0;
}
QLabel#treePreviewZoom {
    color: #64748b;
    background: transparent;
    font-size: 13px;
    padding: 0 6px;
}

/* 1. 全局字体 */
* {
    font-family: "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 14px;
    font-weight: normal;
}

/* Typography roles shared by both Light and Dark themes.
   Section 15 / body 14 / supporting text 13 (logical pixels).
   Keep scientific figure labels and exported report typography independent. */
QLabel[statusText="true"], QStatusBar, QToolTip {
    font-size: 13px;
}
/* Single-line paths and their placeholders use the regular UI font above.
   Reserve monospace for sequence/alignment text and multi-line data panels. */
QPlainTextEdit, QTextEdit[sequenceEditorStyled="true"] {
    font-family: "Cascadia Mono", "Consolas", "Menlo", monospace;
    font-size: 14px;
    font-weight: normal;
}

QMainWindow {
    background: #f7f7f7;
}

/* 3. 菜单栏 & 菜单 */
QMenuBar, QToolBar {
    background: #eaeaea;
    border-bottom: 1px solid #cccccc;
    min-height: 26px;
    font-size: 14px;
}
QMenuBar::item {
    padding: 4px 8px;
}
QMenuBar::item:selected {
    background: #d0eaff;
    border-radius: 3px;
}
QMenu {
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    background: #ffffff;
}
QMenu::item {
    padding: 5px 24px 5px 16px;
}
QMenu::item:selected {
    background: #d0eaff;
    color: #1a1a1a;
    border-radius: 3px;
}

QStatusBar {
    background: #eaeaea;
    border-top: 1px solid #cccccc;
}

QTabWidget::pane {
    border: 1px solid #e0e4e9;
    background: #ffffff;
}

/* Stat value labels in FASTA QC tab */
QLabel[statValue="true"] {
    font-weight: bold;
    color: #2196F3;
}

/* 2. 标签页 */
QTabBar::tab {
    padding: 6px 16px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    background: #e0e0e0;
    color: #555555;
}
QTabBar::tab:selected {
    background: #d0eaff;
    color: #1565c0;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    background: #d6d6d6;
}
QTabBar::tab:!selected {
    margin-top: 3px;
}

QPushButton {
    background: #4a90e2;
    color: #fff;
    border-radius: 4px;
    padding: 5px 12px;
}
QPushButton:hover {
    background: #357ab8;
}
QPushButton#localBlastBuildDatabase {
    background: #21875b;
    color: #ffffff;
}
QPushButton#localBlastBuildDatabase:hover {
    background: #176b45;
}
QPushButton#localBlastBuildDatabase:disabled {
    background: #8cb8a1;
    color: #ffffff;
}
/* Secondary action button — same blue fill, consistent across all buttons */
QPushButton[actionRole="secondary"] {
    color: #ffffff;
    background: #4a90e2;
    border: 1px solid #4a90e2;
}
QPushButton[actionRole="secondary"]:hover {
    background: #357ab8;
    border-color: #357ab8;
}
QPushButton:disabled {
    background: #cbd5e1;
    border-color: #cbd5e1;
    color: #f8fafc;
}
/* Accent buttons keep their blue fill even when disabled (e.g. Export CSV
   before any results exist) so they read as primary actions. */
QPushButton[accentButton="true"]:disabled {
    background: #4a90e2;
    border-color: #4a90e2;
    color: #ffffff;
}
QPushButton[stopButton="true"] {
    background: #d32f2f;
    color: white;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton[stopButton="true"]:hover {
    background: #b71c1c;
}

/* 5. 输入控件 */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    border: 1px solid #bbb;
    border-radius: 4px;
    padding: 3px 6px;
    background: #ffffff;
    selection-background-color: #d0eaff;
    selection-color: #1a1a1a;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1.5px solid #4a90e2;
}
/* Sequence editor widgets keep their custom border on focus */
QTextEdit[sequenceEditorStyled="true"],
QTextEdit[sequenceEditorStyled="true"]:focus,
QPlainTextEdit[sequenceEditorStyled="true"],
QPlainTextEdit[sequenceEditorStyled="true"]:focus {
    border: 1px solid #94a3b8;
    border-radius: 6px;
    padding: 8px 10px;
    background: #ffffff;
}
QTextEdit[sequenceEditorStyled="true"][readOnly="true"],
QTextEdit[sequenceEditorStyled="true"][readOnly="true"]:focus,
QPlainTextEdit[sequenceEditorStyled="true"][readOnly="true"],
QPlainTextEdit[sequenceEditorStyled="true"][readOnly="true"]:focus {
    background: #f7f9fc;
}
QLabel[logSectionTitle="true"] {
    color: #475569;
    font-size: 15px;
    font-weight: 600;
    padding-top: 2px;
}
QLabel[sectionTitle="true"] {
    color: #475569;
    font-size: 15px;
    font-weight: 600;
}
QLabel[mutedText="true"] {
    color: #475569;
    font-size: 13px;
    font-weight: normal;
}
QTextEdit[logViewer="true"],
QTextEdit[logViewer="true"]:focus {
    border: none;
    padding: 8px 10px;
    background: #ffffff;
    color: #1e293b;
    font-family: "Cascadia Mono", "Consolas", "Menlo", monospace;
    font-size: 13px;
    font-weight: normal;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background: #f0f0f0;
    color: #999999;
}
/* Preview panels (read-only QPlainTextEdit showing preview results) */
QPlainTextEdit[previewPanel="true"],
QPlainTextEdit[previewPanel="true"]:focus {
    border: 1px solid #94a3b8;
    border-radius: 6px;
    padding: 8px 10px;
    background: transparent;
}
/* List-style text editors (file-path / accession display, white background) */
QPlainTextEdit[listDisplay="true"],
QPlainTextEdit[listDisplay="true"]:focus {
    border: 1px solid #94a3b8;
    border-radius: 6px;
    padding: 8px 10px;
    background: #ffffff;
}
/* Hint / step-guide labels (small grey secondary text) */
QLabel[hintLabel="true"] {
    color: #888;
    font-size: 13px;
    font-weight: normal;
}

/* 6. GroupBox: quiet boundaries; headings use weight instead of accent color. */
QGroupBox {
    font-size: 15px;
    font-weight: 600;
    border: 1px solid #e0e4e9;
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #475569;
}
QGroupBox[logGroup="true"] {
    margin-top: 4px;
    padding-top: 8px;
}
QGroupBox[logGroup="true"]::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 2px;
}

/* Introduction page: typography and whitespace instead of card borders. */
QWidget#homePage { background: #f7f9fc; }
QWidget#homeContent { background: transparent; }
QLabel#homeLogo { background: transparent; }
QLabel#homeTitle {
    color: #0f172a;
    font-size: 32px;
    font-weight: 600;
}
QLabel#homeTagline { color: #2563a6; font-size: 18px; }
QLabel#homeDescription { color: #475569; font-size: 14px; }
QLabel#homeFeatureTitle { color: #334155; font-size: 15px; font-weight: 600; }
QLabel#homeFeatureDescription { color: #64748b; font-size: 13px; }
QLabel#homeHint { color: #64748b; font-size: 13px; }

