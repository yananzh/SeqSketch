/* 浅色主题 */
/* Compact controls for the tree preview; scoped to this toolbar. */
QWidget#treePreviewToolbar {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
}
QWidget#treePreviewToolbar QToolButton {
    background: #ffffff;
    color: #334155;
    border: 1px solid #d8e0ea;
    border-radius: 5px;
    padding: 0;
    font-size: 14px;
}
QWidget#treePreviewToolbar QToolButton:hover {
    background: #edf4f2;
    color: #527a78;
    border-color: #9bb7b1;
}
QWidget#treePreviewToolbar QToolButton:pressed {
    background: #d7e6e2;
    border-color: #759a94;
}
QWidget#treePreviewToolbar QToolButton:focus {
    border-color: #759a94;
}
QWidget#treePreviewToolbar QToolButton:disabled {
    color: #a8b2c0;
    background: #f1f5f9;
    border-color: #e2e8f0;
}
QLabel#treePreviewZoom {
    color: #64748b;
    background: transparent;
    font-size: 13px;
    padding: 0 6px;
}

/* 1. 全局字体 */
* {
    font-family: "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 14px;
    font-weight: normal;
}

/* Typography roles shared by both Light and Dark themes.
   Section 15 / body 14 / supporting text 13 (logical pixels).
   Keep scientific figure labels and exported report typography independent. */
QLabel[statusText="true"], QStatusBar, QToolTip {
    font-size: 13px;
}
/* Single-line paths and their placeholders use the regular UI font above.
   Reserve monospace for sequence/alignment text and multi-line data panels. */
QPlainTextEdit, QTextEdit[sequenceEditorStyled="true"] {
    font-family: "Cascadia Mono", "Consolas", "Menlo", monospace;
    font-size: 14px;
    font-weight: normal;
}

QMainWindow {
    background: #f7f7f7;
}

/* 3. 菜单栏 & 菜单 */
QMenuBar, QToolBar {
    background: #eaeaea;
    border-bottom: 1px solid #cccccc;
    min-height: 26px;
    font-size: 14px;
}
QMenuBar::item {
    padding: 4px 8px;
}
QMenuBar::item:selected {
    background: #e5efed;
    border-radius: 3px;
}
QMenu {
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    background: #ffffff;
}
QMenu::item {
    padding: 5px 24px 5px 16px;
}
QMenu::item:selected {
    background: #e5efed;
    color: #1a1a1a;
    border-radius: 3px;
}

QStatusBar {
    background: #eaeaea;
    border-top: 1px solid #cccccc;
}

QTabWidget::pane {
    border: 1px solid #e0e4e9;
    background: #ffffff;
}

/* Stat value labels in FASTA QC tab */
QLabel[statValue="true"] {
    font-weight: bold;
    color: #527a78;
}

/* 2. 标签页 */
QTabBar::tab {
    padding: 6px 16px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    background: #e0e0e0;
    color: #555555;
}
QTabBar::tab:selected {
    background: #e5efed;
    color: #385956;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    background: #d6d6d6;
}
QTabBar::tab:!selected {
    margin-top: 3px;
}

/* Neutral actions by default; only execution actions use a solid accent. */
QPushButton {
    background: #ffffff;
    color: #334155;
    border: 1px solid #d8e0ea;
    border-radius: 4px;
    padding: 5px 12px;
}
QPushButton:hover { background: #f1f5f9; border-color: #94a3b8; }
QPushButton:pressed { background: #e2e8f0; }
QPushButton:focus { border-color: #759a94; }
QPushButton[actionRole="primary"] {
    background: #527a78; color: #ffffff; border-color: #527a78;
}
QPushButton[actionRole="primary"]:hover {
    background: #446764; border-color: #446764;
}
QPushButton[actionRole="primary"]:pressed {
    background: #385956; border-color: #385956;
}
QPushButton[actionRole="primary"]:focus { border-color: #385956; }
QPushButton[actionRole="quiet"] {
    background: transparent; color: #475569; border-color: #d8e0ea;
}
QPushButton[actionRole="quiet"]:hover {
    background: #f1f5f9; border-color: #d8e0ea;
}
QPushButton[actionRole="quiet"]:pressed { background: #e2e8f0; }
QPushButton[actionRole="quiet"]:focus { border-color: #759a94; }
QPushButton[actionRole="danger"], QPushButton[stopButton="true"] {
    background: #a65353; color: #ffffff; border-color: #a65353;
}
QPushButton[actionRole="danger"]:hover, QPushButton[stopButton="true"]:hover {
    background: #904646; border-color: #904646;
}
QPushButton[actionRole="danger"]:pressed, QPushButton[stopButton="true"]:pressed {
    background: #7c3c3c; border-color: #7c3c3c;
}
QPushButton[actionRole="danger"]:focus, QPushButton[stopButton="true"]:focus {
    border-color: #7c3c3c;
}
QPushButton[viewToggle="true"] { padding: 4px 12px; border-radius: 3px; }
QPushButton[viewToggle="true"]:checked {
    background: #e5efed; color: #385956; border-color: #759a94;
}
QPushButton:disabled, QPushButton[actionRole]:disabled,
QPushButton[stopButton="true"]:disabled, QPushButton[viewToggle="true"]:disabled {
    background: #f1f5f9; color: #64748b; border-color: #e2e8f0;
}
QPushButton[actionRole="quiet"]:disabled {
    background: transparent; border-color: #e2e8f0; color: #64748b;
}
QProgressBar::chunk { background: #527a78; }

/* 5. 输入控件 */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    border: 1px solid #bbb;
    border-radius: 4px;
    padding: 3px 6px;
    background: #ffffff;
    selection-background-color: #e5efed;
    selection-color: #1a1a1a;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1.5px solid #759a94;
}
/* Sequence editor widgets keep their custom border on focus */
QTextEdit[sequenceEditorStyled="true"],
QTextEdit[sequenceEditorStyled="true"]:focus,
QPlainTextEdit[sequenceEditorStyled="true"],
QPlainTextEdit[sequenceEditorStyled="true"]:focus {
    border: 1px solid #94a3b8;
    border-radius: 6px;
    padding: 8px 10px;
    background: #ffffff;
}
QTextEdit[sequenceEditorStyled="true"][readOnly="true"],
QTextEdit[sequenceEditorStyled="true"][readOnly="true"]:focus,
QPlainTextEdit[sequenceEditorStyled="true"][readOnly="true"],
QPlainTextEdit[sequenceEditorStyled="true"][readOnly="true"]:focus {
    background: #f7f9fc;
}
QLabel[logSectionTitle="true"] {
    color: #475569;
    font-size: 15px;
    font-weight: 600;
    padding-top: 2px;
}
QLabel[sectionTitle="true"] {
    color: #475569;
    font-size: 15px;
    font-weight: 600;
}
QLabel[mutedText="true"] {
    color: #475569;
    font-size: 13px;
    font-weight: normal;
}
QTextEdit[logViewer="true"],
QTextEdit[logViewer="true"]:focus {
    border: none;
    padding: 8px 10px;
    background: #ffffff;
    color: #1e293b;
    font-family: "Cascadia Mono", "Consolas", "Menlo", monospace;
    font-size: 13px;
    font-weight: normal;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background: #f0f0f0;
    color: #999999;
}
/* Preview panels (read-only QPlainTextEdit showing preview results) */
QPlainTextEdit[previewPanel="true"],
QPlainTextEdit[previewPanel="true"]:focus {
    border: 1px solid #94a3b8;
    border-radius: 6px;
    padding: 8px 10px;
    background: transparent;
}
/* List-style text editors (file-path / accession display, white background) */
QPlainTextEdit[listDisplay="true"],
QPlainTextEdit[listDisplay="true"]:focus {
    border: 1px solid #94a3b8;
    border-radius: 6px;
    padding: 8px 10px;
    background: #ffffff;
}
/* Hint / step-guide labels (small grey secondary text) */
QLabel[hintLabel="true"] {
    color: #888;
    font-size: 13px;
    font-weight: normal;
}

/* 6. GroupBox: quiet boundaries; headings use weight instead of accent color. */
QGroupBox {
    font-size: 15px;
    font-weight: 600;
    border: 1px solid #e0e4e9;
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #475569;
}
QGroupBox[logGroup="true"] {
    margin-top: 4px;
    padding-top: 8px;
}
QGroupBox[logGroup="true"]::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 2px;
}

/* Introduction page: typography and whitespace instead of card borders. */
QWidget#homePage { background: #f7f9fc; }
QWidget#homeContent { background: transparent; }
QLabel#homeLogo { background: transparent; }
QLabel#homeTitle {
    color: #0f172a;
    font-size: 32px;
    font-weight: 600;
}
QLabel#homeTagline { color: #527a78; font-size: 18px; }
QLabel#homeDescription { color: #475569; font-size: 14px; }
QLabel#homeFeatureTitle { color: #334155; font-size: 15px; font-weight: 600; }
QLabel#homeFeatureDescription { color: #64748b; font-size: 13px; }
QLabel#homeHint { color: #64748b; font-size: 13px; }

