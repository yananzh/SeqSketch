/* Additional surfaces not explicitly styled by the original light theme. */
QWidget { color: #e2e8f0; }
QDialog, QMessageBox, QScrollArea, QScrollArea > QWidget > QWidget {
    background: #20252d;
}
QLabel { background: transparent; }
/* Spin boxes need explicit arrows when their frame is styled. */
QAbstractSpinBox {
    background: #171c24;
    border: 1px solid #596b82;
    border-radius: 4px;
    padding: 1px 2px;
}
QAbstractSpinBox:focus { border-color: #91b4ae; }
QAbstractSpinBox:disabled { border-color: #343e4b; color: #a0adbe; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    background: transparent;
    border: none;
}
QAbstractSpinBox::up-button:hover:!off, QAbstractSpinBox::down-button:hover:!off {
    background: #3a4656;
}
QAbstractSpinBox::up-arrow {
    image: url(seqsketchicons:spin-up.svg);
    width: 8px;
    height: 5px;
}
QAbstractSpinBox::down-arrow {
    image: url(seqsketchicons:spin-down.svg);
    width: 8px;
    height: 5px;
}
QAbstractSpinBox::up-arrow:off, QAbstractSpinBox::down-arrow:off,
QAbstractSpinBox::up-arrow:disabled, QAbstractSpinBox::down-arrow:disabled {
    image: none;
}
QMenuBar::item, QMenu::item { background: transparent; }
QMenuBar::item:selected, QMenu::item:selected { background: #304b48; }
QRadioButton::indicator {
    width: 12px;
    height: 12px;
    border: 1px solid #8798ad;
    border-radius: 7px;
    background: #171c24;
}
QRadioButton::indicator:hover { border-color: #c3cedd; }
QRadioButton::indicator:checked {
    border-color: #9bbfba;
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
                                stop: 0.48 #9bbfba, stop: 0.57 #171c24);
}
QRadioButton::indicator:disabled { border-color: #596b82; }
QRadioButton::indicator:checked:disabled {
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
                                stop: 0.48 #596b82, stop: 0.57 #171c24);
}
QCheckBox::indicator, QGroupBox::indicator, QAbstractItemView::indicator {
    width: 12px;
    height: 12px;
    border: 1px solid #8798ad;
    border-radius: 3px;
    background: #171c24;
}
QCheckBox::indicator:checked, QGroupBox::indicator:checked, QAbstractItemView::indicator:checked {
    border-color: #9bbfba;
    background: #304b48;
    image: url(seqsketchicons:checkmark.svg);
}
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate {
    border-color: #9bbfba;
    background: #304b48;
    image: url(seqsketchicons:check-indeterminate.svg);
}
QCheckBox::indicator:disabled, QGroupBox::indicator:disabled, QAbstractItemView::indicator:disabled {
    border-color: #596b82;
    background: #262e39;
}
QComboBox::drop-down {
    border: none;
}
QComboBox::down-arrow {
    image: url(seqsketchicons:spin-down.svg);
    width: 8px;
    height: 5px;
}
QAbstractItemView {
    background: #171c24;
    alternate-background-color: #262e39;
    color: #e2e8f0;
    selection-background-color: #304b48;
    selection-color: #ffffff;
}
QListView, QTreeView, QTableView {
    border: 1px solid #596b82;
    border-radius: 4px;
}
QHeaderView::section {
    background: #303b49;
    color: #e2e8f0;
    border: 1px solid #465264;
    padding: 4px 6px;
}
QToolTip { background: #303b49; color: #e2e8f0; border: 1px solid #596b82; }
QProgressBar {
    background: #171c24;
    border: 1px solid #465264;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk { background: #527a78; }
/* Neutral action surfaces remain lighter than the page in Dark mode. */
QPushButton, QPushButton[actionRole="secondary"] {
    background: #303b49; color: #e2e8f0; border-color: #465264;
}
QPushButton:hover, QPushButton[actionRole="secondary"]:hover {
    background: #3a4656; border-color: #596b82;
}
QPushButton:pressed, QPushButton[actionRole="secondary"]:pressed { background: #262e39; }
QPushButton:focus, QPushButton[actionRole="secondary"]:focus { border-color: #91b4ae; }
QPushButton[actionRole="primary"] {
    background: #527a78; color: #ffffff; border-color: #527a78;
}
QPushButton[actionRole="primary"]:hover { background: #446764; border-color: #446764; }
QPushButton[actionRole="primary"]:pressed { background: #385956; border-color: #385956; }
QPushButton[actionRole="primary"]:focus { border-color: #91b4ae; }
QPushButton[actionRole="quiet"] {
    background: transparent; color: #b5c1d1; border-color: #465264;
}
QPushButton[actionRole="quiet"]:hover { background: #303b49; border-color: #465264; }
QPushButton[actionRole="quiet"]:pressed { background: #262e39; }
QPushButton[actionRole="quiet"]:focus { border-color: #91b4ae; }
QPushButton[actionRole="danger"], QPushButton[stopButton="true"] {
    background: #a65353; color: #ffffff; border-color: #a65353;
}
QPushButton[actionRole="danger"]:hover, QPushButton[stopButton="true"]:hover {
    background: #904646; border-color: #904646;
}
QPushButton[actionRole="danger"]:pressed, QPushButton[stopButton="true"]:pressed {
    background: #7c3c3c; border-color: #7c3c3c;
}
QPushButton[actionRole="danger"]:focus, QPushButton[stopButton="true"]:focus {
    border-color: #d69a9a;
}
QPushButton[viewToggle="true"]:checked {
    background: #304b48; color: #c5ded9; border-color: #91b4ae;
}
QPushButton:disabled, QPushButton[actionRole]:disabled,
QPushButton[stopButton="true"]:disabled, QPushButton[viewToggle="true"]:disabled {
    background: #262e39; color: #a0adbe; border-color: #343e4b;
}
QPushButton[actionRole="quiet"]:disabled {
    background: transparent; border-color: #343e4b; color: #a0adbe;
}
QGroupBox { border-color: #596b82; }
QGroupBox::title { color: #b5c1d1; }
QTabBar::tab:disabled, QLabel:disabled { color: #a0adbe; }
